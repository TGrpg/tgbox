# Copy to .dev.vars for `wrangler dev`. In production set with `wrangler secret put <NAME>`.
BOT_TOKEN=123456:replace-me
WEBHOOK_SECRET=replace-me
GITHUB_DISPATCH_TOKEN=replace-me
# Comma-separated Telegram user ids of admins
ADMIN_IDS=
# Chat that receives review requests (group id, or an admin user id)
ADMIN_CHAT_ID=
# Encrypts third-party tokens entered in the admin (e.g. Crypto Pay); same value as the admin Worker's
SETTINGS_KEY=replace-me
