---
import RosetteCheck from "@tabler/icons/filled/rosette-discount-check.svg";
import Send from "@tabler/icons/outline/send.svg";
import type { EntryView, SiteLocale } from "@tgbox/shared";
import Avatar from "@/components/Avatar.astro";
import { ui } from "@/i18n/ui.ts";
import { detailUi } from "@/i18n/ui-detail.ts";

interface Props {
  locale: SiteLocale;
  entry: Pick<EntryView, "title" | "username" | "avatarUrl" | "verified">;
  goHref: string;
}
const { locale, entry, goHref } = Astro.props;
---

{/* Shown by the script below once the page's main actions ([data-detail-actions]) scroll away. */}
<div
  data-detail-sticky
  data-pagefind-ignore
  hidden
  class="fixed inset-x-0 top-[3.75rem] z-20 px-3 md:top-[4.5rem] [&[hidden]]:hidden"
>
  <div
    class="mx-auto flex max-w-[800px] items-center gap-3 rounded-full border border-border/70 bg-(--header-surface) py-1.5 pr-1.5 pl-2 shadow-float backdrop-blur-xl backdrop-saturate-150"
  >
    <Avatar title={entry.title} src={entry.avatarUrl} size={32} />
    <p class="flex min-w-0 flex-1 items-center gap-1 text-sm font-semibold">
      <span class="truncate" dir="auto">{entry.title}</span>
      {entry.verified && (
          <RosetteCheck class="size-4 shrink-0 text-primary" aria-label={ui(locale).entry.verified} role="img" />
        )}
      <span class="hidden truncate font-mono text-xs font-normal text-muted-foreground sm:inline">
        @{entry.username}
      </span>
    </p>
    <a
      href={goHref}
      data-press
      tabindex="-1"
      class="inline-flex h-8 items-center gap-1.5 rounded-full bg-primary px-4 text-sm font-semibold text-primary-foreground hover:bg-primary-hover"
    >
      {detailUi(locale).go}
      <Send class="size-4" aria-hidden="true" />
    </a>
  </div>
</div>

<script>
import { animate } from "motion/mini";
import { durations, easeOut, springs, springTransition } from "@/lib/motion-presets.ts";

const bar = document.querySelector<HTMLElement>("[data-detail-sticky]");
const actions = document.querySelector("[data-detail-actions]");
if (bar && actions) {
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const spring = springTransition(springs.snappy);
  let shown = false;
  new IntersectionObserver(([record]) => {
    // Only once the actions have scrolled above the viewport, not while still below it.
    const show = !!record && !record.isIntersecting && record.boundingClientRect.top < 0;
    if (show === shown) return;
    shown = show;
    if (show) bar.hidden = false;
    if (reduced) {
      bar.hidden = !show;
      return;
    }
    const done = animate(
      bar,
      show
        ? { opacity: [0, 1], translate: ["0 -12px", "0 0"], scale: [0.97, 1] }
        : { opacity: 0, translate: "0 -8px", scale: 0.98 },
      show ? spring : { duration: durations.fast, ease: easeOut },
    );
    if (!show) done.then(() => (bar.hidden = shown));
  }).observe(actions);
}
</script>
