---
import SearchIcon from "@tabler/icons/outline/search.svg";
import type { SiteLocale } from "@tgbox/shared";
import { t } from "@tgbox/shared";
import { ui } from "@/i18n/ui.ts";

interface Props {
  locale: SiteLocale;
}
const { locale } = Astro.props;
const strings = ui(locale).search;
---

{/* Opens the search island (SearchDialog), which listens for clicks on [data-search-trigger]. Icon-only below lg. */}
<button
  type="button"
  id="site-search"
  data-search-trigger
  data-press
  aria-label={t(locale, "site.search")}
  class="inline-flex size-9 items-center justify-center gap-2 rounded-full border border-border bg-card text-sm text-muted-foreground shadow-card transition-colors hover:border-primary/40 hover:text-foreground focus-visible:ring-3 focus-visible:ring-outline/40 outline-none lg:w-52 lg:justify-start lg:px-3 xl:w-40"
>
  <SearchIcon class="size-[1.1rem] shrink-0" aria-hidden="true" />
  <span class="hidden truncate lg:inline">{strings.short}</span>
  <kbd
    class="ml-auto hidden items-center gap-0.5 rounded-md border border-border bg-muted px-1.5 font-sans text-[0.7rem] leading-5 whitespace-nowrap text-muted-foreground lg:inline-flex"
  >
    {strings.shortcut}
  </kbd>
</button>
