---
import ArrowRight from "@tabler/icons/outline/arrow-right.svg";
import BrandGithub from "@tabler/icons/outline/brand-github.svg";
import Plus from "@tabler/icons/outline/plus.svg";
import { type Locale, t } from "@tgbox/shared";
import { localizePath } from "@/i18n/locale.ts";
import { ui } from "@/i18n/ui.ts";
import { fill } from "@/lib/format.ts";
import { awesomeUrl, botLinksUrl, botUrl, botUsername, licence, repoUrl } from "@/lib/site.ts";
import { getSiteData } from "@/lib/site-data.ts";
import LangSwitch from "./LangSwitch.astro";
import Logo from "./Logo.astro";

interface Props {
  locale: Locale;
  path: string;
}
const { locale, path } = Astro.props;
const strings = ui(locale);
const columns = [
  {
    title: strings.footer.sections,
    links: [
      { href: localizePath("/", locale), label: t(locale, "site.home") },
      { href: localizePath("/channel/", locale), label: t(locale, "site.channels") },
      { href: localizePath("/group/", locale), label: t(locale, "site.groups") },
      { href: localizePath("/bot/", locale), label: t(locale, "site.bots") },
      { href: localizePath("/rank/", locale), label: strings.nav.rank },
    ],
  },
  {
    title: strings.footer.explore,
    links: [
      { href: localizePath("/random/", locale), label: t(locale, "site.random") },
      { href: localizePath("/enroll/", locale), label: strings.footer.enroll },
      { href: localizePath("/advertise/", locale), label: strings.page.advertise },
      { href: botUrl, label: `${strings.footer.bot} @${botUsername}`, external: true },
    ],
  },
  {
    title: strings.footer.more,
    links: [
      { href: localizePath("/guides/", locale), label: strings.page.guides },
      { href: localizePath("/tags/", locale), label: strings.page.tags },
      { href: localizePath("/about/", locale), label: strings.page.about },
      { href: localizePath("/privacy-policy/", locale), label: strings.page.privacy },
      { href: localizePath("/donate/", locale), label: strings.page.donate },
      { href: localizePath("/links/", locale), label: strings.page.links },
    ],
  },
];
const year = new Date().getUTCFullYear();
/** The footer keeps to one or two rows of friends; /links/ has the rest. */
const FOOTER_FRIENDS = 12;
const friends = getSiteData().friendLinks;
const shownFriends = friends.slice(0, FOOTER_FRIENDS);
const chip =
  "inline-flex h-8 items-center gap-2 rounded-full border text-sm transition-colors focus-visible:ring-3 focus-visible:ring-outline/40 outline-none";
---

<footer class="mt-20 border-t border-border bg-card pb-24 md:pb-0">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-[1.5fr_repeat(3,1fr)]">
    <div class="space-y-4">
      <a href={localizePath("/", locale)} class="inline-flex items-center gap-2">
        <Logo class="size-8" />
        <span class="text-[1.05rem] font-bold tracking-tight">{t(locale, "site.title")}</span>
      </a>
      <p class="max-w-xs text-sm leading-relaxed text-muted-foreground">
        {t(locale, "site.tagline")}
      </p>
      <LangSwitch locale={locale} path={path} class="-ml-2.5" />
    </div>
    {columns.map((column) => (
        <div>
          <h2 class="mb-3 text-sm font-semibold text-foreground">{column.title}</h2>
          <ul class="space-y-2 text-sm">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-muted-foreground transition-colors hover:text-primary"
                  {...("external" in link ? { rel: "noopener", target: "_blank" } : {})}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
  </div>
  <div class="border-t border-border">
    <div
      class="mx-auto flex max-w-7xl flex-col gap-3 px-4 py-5 sm:flex-row sm:items-start sm:gap-6 sm:px-6"
    >
      <h2 class="shrink-0 text-sm font-semibold text-foreground sm:w-24 sm:pt-1.5">
        {strings.footer.friends}
      </h2>
      <ul class="flex flex-wrap gap-2" data-friend-links>
        {shownFriends.map((friend) => (
            <li>
              <a
                href={friend.url}
                rel="noopener"
                target="_blank"
                title={(locale === "zh" ? friend.descZh : friend.descEn) || undefined}
                class:list={[
                  chip,
                  "border-border bg-background pr-3 pl-1 text-muted-foreground hover:border-primary/40 hover:text-primary",
                ]}
              >
                <span
                  class="grid size-6 place-items-center rounded-full bg-primary-soft text-xs font-semibold text-primary-soft-foreground"
                  aria-hidden="true"
                >
                  {[...friend.name][0]?.toUpperCase()}
                </span>
                {friend.name}
              </a>
            </li>
          ))}
        {friends.length > FOOTER_FRIENDS && (
          <li>
            <a
              href={localizePath("/links/", locale)}
              class:list={[
                chip,
                "border-transparent px-3 text-muted-foreground hover:text-primary",
              ]}
            >
              {strings.footer.allFriends}
              <ArrowRight class="size-3.5" aria-hidden="true" />
            </a>
          </li>
        )}
        <li>
          <a
            href={botLinksUrl}
            rel="noopener"
            target="_blank"
            class:list={[
              chip,
              "border-dashed border-primary/40 px-3 text-primary hover:border-primary hover:bg-primary-soft",
            ]}
          >
            <Plus class="size-3.5" aria-hidden="true" />
            {strings.footer.applyFriend}
          </a>
        </li>
      </ul>
    </div>
  </div>
  <div class="border-t border-border">
    <div
      class="mx-auto max-w-7xl space-y-2 px-4 py-6 text-xs leading-relaxed text-muted-foreground sm:px-6"
    >
      <p class="max-w-4xl">{strings.footer.disclaimer}</p>
      <p class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <span>© {year} {t(locale, "site.title")}. {strings.footer.rights}</span>
        <a
          href={repoUrl}
          rel="noopener"
          target="_blank"
          class="inline-flex items-center gap-1 transition-colors hover:text-primary"
        >
          <BrandGithub class="size-3.5" aria-hidden="true" />
          {strings.footer.openSource}
        </a>
        <a
          href={awesomeUrl}
          rel="noopener"
          target="_blank"
          class="transition-colors hover:text-primary"
          >{strings.footer.awesome}</a
        >
        <a
          href={licence.url}
          rel="noopener"
          target="_blank"
          class="transition-colors hover:text-primary"
          >{fill(strings.footer.licensed, { licence: licence.name })}</a
        >
      </p>
    </div>
  </div>
</footer>
