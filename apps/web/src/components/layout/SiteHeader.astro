---
import Shuffle from "@tabler/icons/outline/arrows-shuffle.svg";
import { type Locale, t } from "@tgbox/shared";
import { localizePath } from "@/i18n/locale.ts";
import { ui } from "@/i18n/ui.ts";
import LangSwitch from "./LangSwitch.astro";
import Logo from "./Logo.astro";
import { navItems } from "./nav-items.ts";
import SearchButton from "./SearchButton.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  locale: Locale;
  path: string;
}
const { locale, path } = Astro.props;
const items = navItems(locale, path);
const randomLabel = t(locale, "site.random");
---

<header
  data-site-header
  class="site-header sticky top-0 z-30 border-b border-transparent transition-[background-color,border-color,box-shadow] duration-200 data-scrolled:border-border/60 data-scrolled:bg-(--header-surface) data-scrolled:shadow-(--shadow-header) data-scrolled:backdrop-blur-xl data-scrolled:backdrop-saturate-150"
>
  <div
    class="mx-auto grid h-14 max-w-7xl grid-cols-[1fr_auto] items-center gap-3 px-4 sm:px-6 md:h-16 md:grid-cols-[1fr_auto_1fr]"
  >
    <a
      href={localizePath("/", locale)}
      class="flex items-center gap-2 justify-self-start rounded-full pr-2 outline-none focus-visible:ring-3 focus-visible:ring-outline/40"
    >
      <Logo class="size-8" />
      <span class="text-[1.05rem] font-bold tracking-tight">{t(locale, "site.title")}</span>
    </a>

    <nav aria-label={ui(locale).nav.primary} class="hidden md:block">
      <ul data-nav class="relative flex items-center gap-0.5 rounded-full p-1 text-[0.925rem]">
        <span
          data-nav-indicator
          aria-hidden="true"
          class="pointer-events-none absolute top-1 left-0 hidden h-[calc(100%-0.5rem)] rounded-full bg-primary-soft"
        ></span>
        {items.map((item) => (
            <li class:list={["relative", item.secondary && "hidden lg:block"]}>
              <a
                href={item.href}
                aria-current={item.active ? "page" : undefined}
                class="nav-link flex items-center gap-1.5 rounded-full px-3.5 py-1.5 text-muted-foreground transition-colors duration-200 outline-none hover:text-foreground focus-visible:ring-3 focus-visible:ring-outline/40 aria-[current=page]:bg-primary-soft aria-[current=page]:font-semibold aria-[current=page]:text-primary-soft-foreground"
              >
                <item.icon class="size-[1.05rem]" aria-hidden="true" />
                {item.label}
              </a>
            </li>
          ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2 justify-self-end">
      <SearchButton locale={locale} />
      <a
        href={localizePath("/random/", locale)}
        aria-label={randomLabel}
        data-press
        class="group relative inline-grid size-9 place-items-center rounded-full border border-border bg-card text-muted-foreground shadow-card transition-colors hover:border-primary/40 hover:text-primary focus-visible:ring-3 focus-visible:ring-outline/40 outline-none"
      >
        <Shuffle class="size-[1.1rem]" aria-hidden="true" />
        <span role="tooltip" class="tip">{randomLabel}</span>
      </a>
      <ThemeToggle locale={locale} />
      <div class="hidden lg:block"><LangSwitch locale={locale} path={path} /></div>
    </div>
  </div>
</header>

<style>
/* Once motion.ts has positioned it, the sliding indicator draws the active pill instead. */
[data-nav][data-ready] .nav-link[aria-current="page"] {
  background: transparent;
}
[data-nav][data-ready] [data-nav-indicator] {
  display: block;
}
</style>
