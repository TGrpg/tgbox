---
import Moon from "@tabler/icons/outline/moon.svg";
import Sun from "@tabler/icons/outline/sun.svg";
import type { SiteLocale } from "@tgbox/shared";
import { ui } from "@/i18n/ui.ts";

interface Props {
  locale: SiteLocale;
}
const { locale } = Astro.props;
---

{/* Click handling lives in BaseLayout (inline, no module). Icons morph via CSS springs. */}
<button
  type="button"
  data-theme-toggle
  data-press
  aria-label={ui(locale).theme.toggle}
  title={ui(locale).theme.toggle}
  class="theme-toggle relative inline-grid size-9 place-items-center rounded-full border border-border bg-card text-muted-foreground shadow-card transition-colors hover:border-primary/40 hover:text-primary focus-visible:ring-3 focus-visible:ring-outline/40 outline-none"
>
  <Sun class="sun col-start-1 row-start-1 size-[1.1rem]" aria-hidden="true" />
  <Moon class="moon col-start-1 row-start-1 size-[1.1rem]" aria-hidden="true" />
</button>

<style>
.theme-toggle svg {
  transition:
    rotate var(--spring-bouncy-duration) var(--spring-bouncy),
    scale var(--spring-bouncy-duration) var(--spring-bouncy),
    opacity var(--motion-fast) var(--ease-out-quint);
}
.moon {
  rotate: -90deg;
  scale: 0.4;
  opacity: 0;
}
:global(.dark) .sun {
  rotate: 90deg;
  scale: 0.4;
  opacity: 0;
}
:global(.dark) .moon {
  rotate: 0deg;
  scale: 1;
  opacity: 1;
}
</style>
