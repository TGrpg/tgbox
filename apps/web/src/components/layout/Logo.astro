---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

{/* Blue disc + paper plane; the orange dot is the brand accent. */}
<svg viewBox="0 0 32 32" class={className} aria-hidden="true">
  <circle cx="16" cy="16" r="15" fill="var(--primary)"></circle>
  <path
    d="M8.2 15.6 21.9 10.3c.7-.3 1.3.2 1.1 1.2l-2.3 10.9c-.2.8-.6 1-1.3.6l-3.6-2.6-1.7 1.7c-.2.2-.4.3-.8.3l.3-3.7 6.6-6c.3-.3-.1-.4-.4-.2l-8.2 5.1-3.5-1.1c-.8-.2-.8-.8.1-1.1Z"
    fill="#fff"
  ></path>
  <circle
    cx="26.5"
    cy="5.5"
    r="4"
    fill="var(--brand-dot)"
    stroke="var(--background)"
    stroke-width="2"
  ></circle>
</svg>
