---
import BotIcon from "@tabler/icons/outline/robot.svg";
import ChannelIcon from "@tabler/icons/outline/speakerphone.svg";
import Stack from "@tabler/icons/outline/stack-2.svg";
import GroupIcon from "@tabler/icons/outline/users.svg";
import type { SiteLocale } from "@tgbox/shared";
import { kindTitles } from "@/i18n/ui.ts";
import { homeUi } from "@/i18n/ui-home.ts";
import { formatNumber } from "@/lib/format.ts";
import { getSiteData } from "@/lib/site-data.ts";

interface Props {
  locale: SiteLocale;
}
const { locale } = Astro.props;
const strings = homeUi(locale);
const kinds = kindTitles(locale);
const { stats } = getSiteData();
const items = [
  { label: strings.total, value: stats.total, Icon: Stack },
  { label: kinds.channel, value: stats.channels, Icon: ChannelIcon },
  { label: kinds.group, value: stats.groups, Icon: GroupIcon },
  { label: kinds.bot, value: stats.bots, Icon: BotIcon },
];
---

<dl
  aria-label={strings.statsLabel}
  class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-border bg-border shadow-card lg:grid-cols-4"
>
  {items.map(({ label, value, Icon }) => (
    <div data-reveal class="flex items-center gap-3 bg-card px-4 py-4 sm:px-6 sm:py-5">
      <span class="inline-grid size-10 shrink-0 place-items-center rounded-xl bg-primary-soft text-primary-soft-foreground sm:size-11">
        <Icon class="size-5" aria-hidden="true" />
      </span>
      <div class="flex min-w-0 flex-col-reverse">
        <dt class="text-xs text-muted-foreground sm:text-sm">{label}</dt>
        <dd class="text-2xl leading-tight font-extrabold tracking-tight tabular-nums sm:text-3xl" data-count-up={value}>
          {formatNumber(value, locale)}
        </dd>
      </div>
    </div>
  ))}
</dl>
