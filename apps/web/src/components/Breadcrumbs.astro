---
import ChevronRight from "@tabler/icons/outline/chevron-right.svg";
import type { SiteLocale } from "@tgbox/shared";
import { ui } from "@/i18n/ui.ts";
import { breadcrumbJsonLd } from "@/lib/json-ld.ts";
import { absoluteUrl } from "@/lib/site.ts";

interface Props {
  locale: SiteLocale;
  /** The last item is the current page and should have no href. */
  items: { label: string; href?: string | undefined }[];
}

const { locale, items } = Astro.props;
// The visible trail is the one page-level markup describes, so it emits the JSON-LD itself;
// only pages without a breadcrumb nav (the detail page) build their own.
const jsonLd = breadcrumbJsonLd(
  items.map((item) => ({ name: item.label, url: item.href && absoluteUrl(item.href) })),
);
---

<nav aria-label={ui(locale).breadcrumbs.label}>
  <ol class="flex flex-wrap items-center gap-1 text-sm text-muted-foreground">
    {items.map((item, index) => (
        <li class="flex items-center gap-1">
          {index > 0 && <ChevronRight class="size-3.5 opacity-50" aria-hidden="true" />}
          {item.href ? (
            <a href={item.href} class="transition-colors hover:text-foreground">
              {item.label}
            </a>
          ) : (
            <span aria-current="page" class="text-foreground">
              {item.label}
            </span>
          )}
        </li>
      ))}
  </ol>
</nav>
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
