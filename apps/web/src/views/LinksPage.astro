---
import ArrowUpRight from "@tabler/icons/outline/arrow-up-right.svg";
import Plus from "@tabler/icons/outline/plus.svg";
import type { SiteLocale } from "@tgbox/shared";
import { ui } from "@/i18n/ui.ts";
import PageLayout from "@/layouts/PageLayout.astro";
import { botLinksUrl } from "@/lib/site.ts";
import { getSiteData } from "@/lib/site-data.ts";

interface Props {
  locale: SiteLocale;
}
const { locale } = Astro.props;
const zh = locale !== "en";
const friends = getSiteData().friendLinks.map((friend) => ({
  ...friend,
  host: new URL(friend.url).hostname.replace(/^www\./, ""),
  // Approved applications carry one text in both fields; an admin may have filled only one.
  description: (zh ? friend.descZh || friend.descEn : friend.descEn || friend.descZh) || null,
}));

/** Telegram's own resources, below the friends. */
const official = [
  {
    name: "Telegram",
    url: "https://telegram.org/",
    zh: "Telegram 官方网站，下载客户端和查看最新功能。",
    en: "Official Telegram website: download apps and read about new features.",
  },
  {
    name: "Telegram FAQ",
    url: "https://telegram.org/faq",
    zh: "官方常见问题，涵盖频道、群组、隐私和账号安全。",
    en: "Official FAQ covering channels, groups, privacy and account security.",
  },
  {
    name: "Telegram Bot Platform",
    url: "https://core.telegram.org/bots",
    zh: "官方机器人开发文档，适合想自己做机器人的开发者。",
    en: "Official bot platform docs for developers building their own bots.",
  },
];
---

<PageLayout
  locale={locale}
  title={ui(locale).page.links}
  eyebrow="Links"
  description={zh
      ? "我们的友情链接网站，以及交换友链的方式。"
      : "Sites we are friends with, and how to exchange links with us."}
>
  {friends.length > 0 ? (
      <ul class="not-prose grid gap-3 sm:grid-cols-2" data-friend-links>
        {friends.map((friend) => (
            <li>
              <a
                href={friend.url}
                rel="noopener"
                target="_blank"
                data-hover-lift
                class="group flex h-full items-start gap-3 rounded-xl border border-border bg-card p-4 transition-colors hover:border-primary/40"
              >
                <span
                  class="grid size-10 shrink-0 place-items-center rounded-full bg-primary-soft text-base font-semibold text-primary-soft-foreground"
                  aria-hidden="true"
                >
                  {[...friend.name][0]?.toUpperCase()}
                </span>
                <span class="min-w-0 flex-1">
                  <span class="flex items-center gap-1 font-medium text-foreground group-hover:text-primary">
                    <span class="truncate">{friend.name}</span>
                    <ArrowUpRight class="size-4 shrink-0 opacity-60" aria-hidden="true" />
                  </span>
                  <span class="block truncate text-xs text-muted-foreground">{friend.host}</span>
                  {friend.description && (
                    <span class="mt-1.5 block text-sm leading-relaxed text-muted-foreground">
                      {friend.description}
                    </span>
                  )}
                </span>
              </a>
            </li>
          ))}
      </ul>
    ) : (
      <p class="!mt-0 rounded-xl border border-dashed border-border p-6 text-center text-muted-foreground">
        {zh ? "还没有友情链接，欢迎成为第一个。" : "No friend sites yet. Be the first."}
      </p>
    )}

  <h2>{zh ? "交换友链" : "Exchange links"}</h2>
  <p>
    {zh
        ? "欢迎与 Telegram、效率工具、开源资源相关的网站交换友情链接。申请条件："
        : "We welcome link exchanges with sites about Telegram, productivity tools and open resources. Requirements:"}
  </p>
  <ul>
    {zh ? (
        <>
          <li>网站可以正常访问，有持续更新的原创或整理内容；</li>
          <li>内容合法合规，不涉及色情、赌博、诈骗等灰黑产；</li>
          <li>已在你的网站上添加本站链接。</li>
        </>
      ) : (
        <>
          <li>The site is reachable and regularly updated with original or curated content;</li>
          <li>Its content is lawful, with no adult, gambling, scam or other grey-market material;</li>
          <li>You have already added a link to this site.</li>
        </>
      )}
  </ul>
  <p>
    {zh
        ? "点下面的按钮，在机器人里依次发送网址、名称和一句话简介即可，审核结果会私信通知你。"
        : "Tap the button below and send the bot your site's address, name and a one-line description. We'll message you with the result."}
  </p>
  <p class="not-prose mt-4">
    <a
      href={botLinksUrl}
      rel="noopener"
      target="_blank"
      data-press
      class="inline-flex h-10 items-center gap-2 rounded-full bg-primary px-5 font-medium text-primary-foreground transition-colors hover:bg-primary/90"
    >
      <Plus class="size-4" aria-hidden="true" />
      {ui(locale).footer.applyFriend}
    </a>
  </p>

  <h2>{zh ? "官方资源" : "Official resources"}</h2>
  <ul
    class="!list-none !space-y-0 !pl-0 divide-y divide-border rounded-xl border border-border bg-card"
  >
    {official.map((link) => (
        <li class="!mt-0 flex flex-col gap-1 p-4 sm:flex-row sm:items-baseline sm:gap-6">
          <a href={link.url} rel="noopener" target="_blank" class="shrink-0 font-medium sm:w-56">
            {link.name}
          </a>
          <span class="text-sm text-muted-foreground">{zh ? link.zh : link.en}</span>
        </li>
      ))}
  </ul>
</PageLayout>
