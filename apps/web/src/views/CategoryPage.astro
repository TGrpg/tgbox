---
import { type CategoryView, type SiteLocale, t } from "@tgbox/shared";
import CategoryIcon from "@/components/CategoryIcon.astro";
import KindGrid from "@/components/kind/KindGrid.astro";
import KindListingShell from "@/components/kind/KindListingShell.astro";
import KindPageHeader from "@/components/kind/KindPageHeader.astro";
import KindSortTabs from "@/components/kind/KindSortTabs.astro";
import LangFilter from "@/components/kind/LangFilter.astro";
import TagFilter from "@/components/kind/TagFilter.astro";
import JsonLd from "@/components/layout/JsonLd.astro";
import Pagination from "@/components/Pagination.astro";
import SubmitButton from "@/components/SubmitButton.astro";
import { localizePath } from "@/i18n/locale.ts";
import { kindTitles, ui } from "@/i18n/ui.ts";
import { kindUi } from "@/i18n/ui-kind.ts";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { fill } from "@/lib/format.ts";
import { itemListJsonLd } from "@/lib/json-ld.ts";
import {
  categoryListingBase,
  type ListingSort,
  listingLangs,
  listingTags,
  sortEntries,
} from "@/lib/kind-listing.ts";
import { categorySeo, MIN_INDEXED_LISTING_ENTRIES } from "@/lib/seo.ts";
import { absoluteUrl } from "@/lib/site.ts";
import { getSiteData, localName, PAGE_SIZE, pageHref, pageSlice } from "@/lib/site-data.ts";

interface Props {
  locale: SiteLocale;
  category: CategoryView;
  sort: ListingSort;
  page: number;
}
const { locale, category, sort, page } = Astro.props;
const strings = ui(locale);
const kindStrings = kindUi(locale);
const kindTitle = kindTitles(locale)[category.kind];
const name = localName(category, locale);
const entries = sortEntries(
  getSiteData().entries.filter(
    (entry) => entry.kind === category.kind && entry.category === category.slug,
  ),
  sort,
);
const totalPages = Math.max(1, Math.ceil(entries.length / PAGE_SIZE));
const base = localizePath(categoryListingBase(category.kind, category.slug, sort), locale);
const sortSuffix = sort === "latest" ? ` · ${kindStrings.latestTitle}` : "";
const pageSuffix = page > 1 ? ` · ${fill(strings.pagination.page, { n: page })}` : "";
const visible = pageSlice(entries, page);
const langs = listingLangs(visible);
const tags = listingTags(visible);
const seo = categorySeo(locale, {
  kind: category.kind,
  kindWord: kindTitle,
  category: name,
  count: entries.length,
  page,
  examples: visible.map((entry) => entry.title),
});
const title = `${seo.title}${sortSuffix}`;
const description = seo.description;
const pageUrl = absoluteUrl(
  localizePath(pageHref(categoryListingBase(category.kind, category.slug, sort), page), locale),
);
// The breadcrumb JSON-LD comes from the visible trail in KindPageHeader.
const jsonLd = [
  itemListJsonLd({
    name: `${name} · ${kindTitle}`,
    url: pageUrl,
    items: visible.map((entry) => ({
      name: entry.title,
      url: absoluteUrl(localizePath(`/detail/${entry.username}/`, locale)),
    })),
  }),
];
---

{/*
  The "latest" order duplicates the members order, so only the latter is indexed, and a category
  holding one or two entries says nothing the detail pages it links to don't already say.
*/}
<BaseLayout
  locale={locale}
  title={title}
  description={description}
  keywords={seo.keywords}
  noindex={sort === "latest" || entries.length < MIN_INDEXED_LISTING_ENTRIES}
>
  <JsonLd slot="head" data={jsonLd} />
  <KindListingShell locale={locale} kind={category.kind} current={category.slug}>
    <KindPageHeader
      locale={locale}
      title={`${name}${pageSuffix}`}
      description={description}
      count={{ n: entries.length, template: kindStrings.entries }}
      breadcrumbs={[
          { label: t(locale, "site.home"), href: localizePath("/", locale) },
          { label: kindTitle, href: localizePath(`/${category.kind}/`, locale) },
          { label: name },
        ]}
    >
      <SubmitButton slot="action" locale={locale} />
      <CategoryIcon
        slug={category.slug}
        icon={category.icon}
        slot="icon"
        class="size-7 sm:size-8"
      />
      <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-3 border-t border-border pt-4">
        <KindSortTabs locale={locale} kind={category.kind} slug={category.slug} sort={sort} />
        {langs.length > 1 && <LangFilter locale={locale} langs={langs} />}
        {tags.length > 0 && <TagFilter locale={locale} tags={tags} />}
      </div>
    </KindPageHeader>
    <KindGrid locale={locale} entries={visible} eager={10} class="mt-6" />
    <p
      data-filter-empty
      hidden
      class="mt-6 rounded-2xl border border-dashed border-border bg-card/50 p-10 text-center text-muted-foreground"
    >
      {kindStrings.tagFilter.empty}
    </p>
    <Pagination
      locale={locale}
      current={page}
      total={totalPages}
      href={(target) => pageHref(base, target)}
    />
  </KindListingShell>
</BaseLayout>
