---
import Book from "@tabler/icons/outline/book.svg";
import { type SiteLocale, t } from "@tgbox/shared";
import KindPageHeader from "@/components/kind/KindPageHeader.astro";
import JsonLd from "@/components/layout/JsonLd.astro";
import { localizePath } from "@/i18n/locale.ts";
import { ui } from "@/i18n/ui.ts";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { fill, formatDate } from "@/lib/format.ts";
import { GUIDES_PATH, guidePath, listGuides, readingMinutes } from "@/lib/guides.ts";
import { itemListJsonLd } from "@/lib/json-ld.ts";
import { guidesSeo } from "@/lib/seo.ts";
import { absoluteUrl } from "@/lib/site.ts";

interface Props {
  locale: SiteLocale;
}
const { locale } = Astro.props;
const strings = ui(locale);
const seo = guidesSeo(locale);
const guides = await listGuides(locale);
// The breadcrumb JSON-LD comes from the visible trail in KindPageHeader.
const jsonLd = [
  itemListJsonLd({
    name: strings.page.guides,
    url: absoluteUrl(localizePath(GUIDES_PATH, locale)),
    items: guides.map((guide) => ({
      name: guide.data.title,
      url: absoluteUrl(localizePath(guidePath(guide.data.slug), locale)),
    })),
  }),
];
---

<BaseLayout locale={locale} title={seo.title} description={seo.description} keywords={seo.keywords}>
  <JsonLd slot="head" data={jsonLd} />
  <div class="mx-auto max-w-3xl px-4 pt-5 pb-20 sm:px-6 md:pt-8">
    <KindPageHeader
      locale={locale}
      title={strings.page.guides}
      description={strings.guides.lead}
      breadcrumbs={[
          { label: t(locale, "site.home"), href: localizePath("/", locale) },
          { label: strings.page.guides },
        ]}
    >
      <Book slot="icon" class="size-7 sm:size-8" aria-hidden="true" />
    </KindPageHeader>

    {guides.length === 0 ? (
        <p
          class="mt-8 rounded-xl border border-dashed border-border p-10 text-center text-sm text-muted-foreground"
        >
          {strings.guides.empty}
        </p>
      ) : (
        <ul class="mt-8 space-y-4">
          {guides.map((guide) => (
            <li>
              <article
                data-guide-card={guide.data.slug}
                data-reveal
                data-hover-lift
                class="group relative rounded-2xl border border-border bg-card p-5 shadow-card hover:border-primary/30"
              >
                <h2 class="text-lg leading-snug font-semibold tracking-tight">
                  <a
                    href={localizePath(guidePath(guide.data.slug), locale)}
                    class="outline-none after:absolute after:inset-0 after:rounded-2xl group-hover:text-primary-accent focus-visible:after:ring-3 focus-visible:after:ring-outline/40"
                  >
                    {guide.data.title}
                  </a>
                </h2>
                <p class="mt-2 text-sm leading-relaxed text-pretty text-muted-foreground">
                  {guide.data.description}
                </p>
                <p class="mt-3 flex flex-wrap items-center gap-x-2 font-mono text-xs text-muted-foreground">
                  <span>{strings.page.updated}</span>
                  <time datetime={guide.data.updatedAt.toISOString()}>
                    {formatDate(guide.data.updatedAt.toISOString(), locale)}
                  </time>
                  <span aria-hidden="true">·</span>
                  <span>{fill(strings.guides.readingTime, { n: readingMinutes(guide.body ?? "") })}</span>
                </p>
              </article>
            </li>
          ))}
        </ul>
      )}
  </div>
</BaseLayout>
