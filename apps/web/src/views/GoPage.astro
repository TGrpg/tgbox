---
import BrandTelegram from "@tabler/icons/outline/brand-telegram.svg";
import DeviceMobile from "@tabler/icons/outline/device-mobile.svg";
import Send from "@tabler/icons/outline/send.svg";
import type { SiteLocale } from "@tgbox/shared";
import { dataPath } from "@/i18n/locale.ts";
import { ui } from "@/i18n/ui.ts";
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  locale: SiteLocale;
}
const { locale } = Astro.props;
const strings = ui(locale).go;
const hosts = ["t.me", "telegram.me", "telegram.dog"];
// Ring geometry for the countdown around the avatar.
const RING_RADIUS = 52;
const ringLength = 2 * Math.PI * RING_RADIUS;
---

<BaseLayout locale={locale} title={strings.title} noindex announcement={false}>
  <section class="relative isolate overflow-hidden">
    <div class="go-glow absolute inset-x-0 top-0 -z-10 h-[28rem]" aria-hidden="true"></div>
    <div
      id="go"
      class="mx-auto flex max-w-md flex-col px-4 pt-10 pb-28 sm:pt-16 md:pb-20"
      data-redirecting={strings.redirecting}
      data-timeout={strings.timeout}
      data-failed={strings.failed}
      data-invalid={strings.invalid}
      data-cancelled={strings.cancelled}
      data-cards={dataPath("random-all.json", locale)}
    >
      <div
        data-reveal
        class="rounded-[1.75rem] border border-border bg-card px-5 pt-8 pb-5 text-center shadow-float sm:px-7"
      >
        <div class="relative mx-auto grid size-[7.5rem] place-items-center">
          <svg
            viewBox="0 0 120 120"
            class="absolute inset-0 size-full -rotate-90"
            aria-hidden="true"
          >
            <circle
              cx="60"
              cy="60"
              r={RING_RADIUS}
              fill="none"
              stroke="var(--muted)"
              stroke-width="5"
            ></circle>
            <circle
              data-go-ring
              cx="60"
              cy="60"
              r={RING_RADIUS}
              fill="none"
              stroke="var(--primary)"
              stroke-width="5"
              stroke-linecap="round"
              stroke-dasharray={ringLength}
              stroke-dashoffset={ringLength}
              data-length={ringLength}
            ></circle>
          </svg>
          <span
            data-go-avatar
            class="relative grid size-[5.75rem] place-items-center overflow-hidden rounded-full bg-linear-to-br from-[#72d5fd] to-[#2a9ef1] text-4xl font-semibold text-white"
            aria-hidden="true"
          >
            <BrandTelegram data-go-avatar-icon class="size-11" />
            <span data-go-initial hidden></span>
            <img
              data-go-avatar-img
              hidden
              alt=""
              width="92"
              height="92"
              class="absolute inset-0 size-full object-cover"
            >
          </span>
          <span
            data-go-count
            hidden
            class="absolute -right-1 bottom-1 grid size-8 place-items-center rounded-full border-2 border-card bg-primary font-mono text-sm font-bold text-primary-foreground tabular-nums"
          ></span>
        </div>

        <h1 data-go-title class="mt-5 text-2xl font-bold tracking-tight" dir="auto">
          {strings.title}
        </h1>
        <p data-go-target class="mt-0.5 font-mono text-sm text-muted-foreground"></p>
        <p
          data-go-status
          class="mx-auto mt-3 max-w-xs text-sm leading-relaxed text-muted-foreground"
          aria-live="polite"
        >
          {strings.lead}
        </p>

        <div data-go-actions hidden class="mt-6 text-left">
          <p class="px-1 text-xs font-medium tracking-wide text-muted-foreground">
            {strings.manual}
          </p>
          <ul class="mt-2 space-y-1.5">
            {hosts.map((host) => (
                <li>
                  <a
                    data-go-host={host}
                    href={`https://${host}/`}
                    data-press
                    class="group grid grid-cols-[7rem_1fr_auto] items-center gap-3 rounded-2xl border border-transparent bg-muted/60 px-3.5 py-2.5 transition-colors outline-none hover:border-primary/30 hover:bg-primary-soft focus-visible:ring-3 focus-visible:ring-outline/40 data-winner:border-primary/40 data-winner:bg-primary-soft"
                  >
                    <span class="flex items-center gap-1.5 font-mono text-sm font-medium">
                      {host}
                    </span>
                    <span class="relative h-1.5 overflow-hidden rounded-full bg-border" aria-hidden="true">
                      <span data-go-bar={host} class="go-bar absolute inset-y-0 left-0 w-full rounded-full"></span>
                    </span>
                    <span class="flex min-w-[4.5rem] items-center justify-end gap-1.5">
                      <span
                        data-go-fastest
                        hidden
                        class="rounded-full bg-primary px-1.5 text-[0.65rem] leading-4 font-semibold text-primary-foreground"
                      >
                        {strings.fastest}
                      </span>
                      <span data-go-time={host} class="font-mono text-xs text-muted-foreground tabular-nums">
                        {strings.testing}
                      </span>
                    </span>
                  </a>
                </li>
              ))}
          </ul>

          <div class="mt-5 flex flex-col-reverse gap-2 sm:grid sm:grid-cols-2">
            <a
              data-go-app
              href="tg://resolve"
              data-press
              class="inline-flex h-11 items-center justify-center gap-1.5 rounded-full border border-border bg-card px-4 text-sm font-medium whitespace-nowrap transition-colors outline-none hover:border-primary/40 hover:text-primary-accent focus-visible:ring-3 focus-visible:ring-outline/40"
            >
              <DeviceMobile class="size-4" aria-hidden="true" />
              {strings.openApp}
            </a>
            <a
              data-go-now
              href="https://t.me/"
              data-press
              class="inline-flex h-11 items-center justify-center gap-1.5 rounded-full bg-primary px-4 text-sm font-semibold text-primary-foreground shadow-[0_10px_24px_-12px_color-mix(in_oklch,var(--primary)_80%,transparent)] transition-colors outline-none hover:bg-primary-hover focus-visible:ring-3 focus-visible:ring-primary/50"
            >
              {strings.goNow}
              <Send class="size-4" aria-hidden="true" />
            </a>
          </div>
          <button
            type="button"
            data-go-cancel
            hidden
            class="mx-auto mt-3 block rounded-full px-3 py-1 text-xs text-muted-foreground underline-offset-4 hover:text-foreground hover:underline"
          >
            {strings.cancel}
          </button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.go-glow {
  background: radial-gradient(
    60% 70% at 50% 0%,
    color-mix(in oklch, var(--primary) 18%, transparent),
    transparent 70%
  );
}
.go-bar {
  background: var(--primary);
  transform-origin: left;
  scale: 0.35 1;
  opacity: 0.35;
  animation: go-probe 1.1s var(--ease-out-quint) infinite alternate;
}
.go-bar[data-done] {
  animation: none;
  opacity: 1;
}
.go-bar[data-speed="fast"] {
  background: #2fb46c;
}
.go-bar[data-speed="ok"] {
  background: #f0a43a;
}
.go-bar[data-speed="slow"] {
  background: var(--error);
}
@keyframes go-probe {
  from {
    translate: -30% 0;
  }
  to {
    translate: 190% 0;
  }
}
@media (prefers-reduced-motion: reduce) {
  .go-bar {
    animation: none;
  }
}
</style>

<script>
import { parseTelegramRef } from "@tgbox/shared";
import { animate } from "motion/mini";
import { springs, springTransition } from "@/lib/motion-presets.ts";

const PROBE_TIMEOUT_MS = 4000;
const REDIRECT_DELAY_S = 3;

interface Card {
  u: string;
  t: string;
  a: string | null;
}

const root = document.getElementById("go");
if (root) {
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const lift = springTransition(springs.lift);
  const status = root.querySelector<HTMLElement>("[data-go-status]");
  const raw = new URLSearchParams(location.search).get("u") ?? "";
  const username = raw ? parseTelegramRef(`@${raw.replace(/^@/, "")}`) : null;
  const say = (text: string | undefined) => {
    if (status) status.textContent = text ?? "";
  };

  if (!username) {
    say(root.dataset.invalid);
  } else {
    const target = root.querySelector<HTMLElement>("[data-go-target]");
    if (target) target.textContent = `@${username}`;
    root.querySelector("[data-go-app]")?.setAttribute("href", `tg://resolve?domain=${username}`);
    const goNow = root.querySelector<HTMLAnchorElement>("[data-go-now]");
    if (goNow) goNow.href = `https://t.me/${username}`;
    const actions = root.querySelector<HTMLElement>("[data-go-actions]");
    if (actions) actions.hidden = false;
    showEntry(username);

    let winner: string | undefined;
    let redirect: ReturnType<typeof setTimeout> | undefined;
    let countdown: { stop(): void } | undefined;
    const cancel = root.querySelector<HTMLElement>("[data-go-cancel]");
    cancel?.addEventListener("click", () => {
      clearTimeout(redirect);
      countdown?.stop();
      cancel.hidden = true;
      root.querySelector<HTMLElement>("[data-go-count]")?.toggleAttribute("hidden", true);
      say(root.dataset.cancelled);
    });

    const probes = [...root.querySelectorAll<HTMLAnchorElement>("[data-go-host]")].map(
      async (link) => {
        const host = link.dataset.goHost ?? "";
        const url = `https://${host}/${username}`;
        link.href = url;
        const time = root.querySelector(`[data-go-time="${host}"]`);
        const bar = root.querySelector<HTMLElement>(`[data-go-bar="${host}"]`);
        const settle = (ms: number | undefined) => {
          if (!bar) return;
          bar.setAttribute("data-done", "");
          bar.dataset.speed =
            ms === undefined ? "slow" : ms < 400 ? "fast" : ms < 1200 ? "ok" : "slow";
          const fill = ms === undefined ? 1 : Math.max(0.08, Math.min(ms / 1500, 1));
          const frame = { translate: "0 0", scale: `${fill} 1` };
          if (reduced) Object.assign(bar.style, frame);
          else animate(bar, { ...frame, opacity: 1 }, lift);
        };
        const start = performance.now();
        try {
          // Opaque no-cors response: we only learn that the host answered, which is all we need.
          await fetch(`https://${host}/favicon.ico`, {
            mode: "no-cors",
            cache: "no-store",
            signal: AbortSignal.timeout(PROBE_TIMEOUT_MS),
          });
        } catch {
          if (time) time.textContent = root.dataset.timeout ?? "";
          settle(undefined);
          throw new Error(host);
        }
        const ms = Math.round(performance.now() - start);
        if (time) time.textContent = `${ms} ms`;
        settle(ms);
        if (!winner) {
          winner = host;
          link.setAttribute("data-winner", "");
          link.querySelector<HTMLElement>("[data-go-fastest]")?.toggleAttribute("hidden", false);
          if (goNow) goNow.href = url;
          say((root.dataset.redirecting ?? "").replace("{host}", host));
          startCountdown(url);
        }
      },
    );
    Promise.any(probes).catch(() => say(root.dataset.failed));

    function startCountdown(url: string) {
      const ring = root?.querySelector<SVGCircleElement>("[data-go-ring]");
      const count = root?.querySelector<HTMLElement>("[data-go-count]");
      if (cancel) cancel.hidden = false;
      if (count) {
        count.hidden = false;
        let left = REDIRECT_DELAY_S;
        count.textContent = String(left);
        const tick = setInterval(() => {
          left -= 1;
          if (left <= 0 || cancel?.hidden) clearInterval(tick);
          else count.textContent = String(left);
        }, 1000);
      }
      if (ring) {
        const length = Number(ring.dataset.length);
        countdown = animate(
          ring,
          { strokeDashoffset: [`${length}px`, "0px"] },
          { duration: REDIRECT_DELAY_S, ease: "linear" },
        );
      }
      redirect = setTimeout(() => location.replace(url), REDIRECT_DELAY_S * 1000);
    }
  }
}

/** Title and avatar come from the drift-bottle shard, which lists every approved entry. */
async function showEntry(username: string) {
  const go = document.getElementById("go");
  try {
    const response = await fetch(go?.dataset.cards ?? "/data/random-all.json");
    if (!response.ok) return;
    const cards: Card[] = await response.json();
    const entry = cards.find((card) => card.u.toLowerCase() === username.toLowerCase());
    if (!entry || !go) return;
    const title = go.querySelector<HTMLElement>("[data-go-title]");
    if (title) title.textContent = entry.t;
    const initial = go.querySelector<HTMLElement>("[data-go-initial]");
    go.querySelector("[data-go-avatar-icon]")?.setAttribute("hidden", "");
    if (initial) {
      initial.hidden = false;
      initial.textContent = Array.from(entry.t.trim())[0]?.toUpperCase() ?? "@";
    }
    const img = go.querySelector<HTMLImageElement>("[data-go-avatar-img]");
    if (img && entry.a) {
      img.addEventListener("load", () => (img.hidden = false), { once: true });
      img.src = entry.a;
    }
  } catch {
    // The generic Telegram mark stays; redirecting does not depend on it.
  }
}
</script>
