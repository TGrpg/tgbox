---
import "@/styles/starwind.css";
import type { Locale } from "@tgbox/shared";
import Announcement from "@/components/layout/Announcement.astro";
import BackToTop from "@/components/layout/BackToTop.astro";
import Footer from "@/components/layout/Footer.astro";
import LangSuggest from "@/components/layout/LangSuggest.astro";
import MobileTabBar from "@/components/layout/MobileTabBar.astro";
import Seo from "@/components/layout/Seo.astro";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import SearchDialog from "@/components/search/SearchDialog.tsx";
import { alternatePaths, htmlLang, isNotFoundPath } from "@/i18n/locale.ts";
import { ui } from "@/i18n/ui.ts";
import { announcementKey, paidAnnouncement } from "@/lib/announcement.ts";
import { langChoice } from "@/lib/lang-pref.ts";
import { siteUrl } from "@/lib/site.ts";
import { byMembers, getSiteData } from "@/lib/site-data.ts";

interface Props {
  locale: Locale;
  title?: string | undefined;
  description?: string | undefined;
  keywords?: string | undefined;
  image?: string | undefined;
  type?: "website" | "article" | undefined;
  noindex?: boolean | undefined;
  /** Slots: default (page body), "head" (extra head tags, e.g. JSON-LD). */
  /** Hide the announcement bar (e.g. on the 404 page). */
  announcement?: boolean | undefined;
}

const {
  locale,
  title,
  description,
  keywords,
  image,
  type,
  noindex,
  announcement: showAnnouncement = true,
} = Astro.props;
const path = Astro.url.pathname;
const strings = ui(locale);
const data = getSiteData();
// Paid announcement bars take the admin's place while they run; several take turns (below).
const paidBars = showAnnouncement ? data.sponsoredAnnouncements.map(paidAnnouncement) : [];
const sponsored = paidBars.length > 0;
const announcement = !showAnnouncement ? null : (paidBars[0] ?? data.announcement);
// Every paid bar gets its turn: one at random per page load (the first one without JS).
const rotatePaidBars = `(() => {
  const bars = document.querySelectorAll("[data-announcement-rotation]");
  const pick = Math.floor(Math.random() * bars.length);
  bars.forEach((bar, index) => { bar.hidden = index !== pick; });
})();`;
// Titles of the largest entries always hit the (zh-built) index, unlike localized tag names.
const hotKeywords = byMembers(data.entries)
  .slice(0, 6)
  .map((entry) => entry.title);
// Only the admin's own notice stays dismissed across pages; a paid bar comes back on the next load.
const dismissKey = announcement && !sponsored ? announcementKey(announcement) : "";
// The other locale's copy of this page; a 404 has none, so it neither redirects nor suggests.
const otherLocalePath = isNotFoundPath(path)
  ? null
  : alternatePaths(path)[locale === "zh" ? "en" : "zh"];
// A remembered language wins before first paint; otherwise the browser's may earn a suggestion.
const langScript =
  otherLocalePath &&
  `(() => {
  const root = document.documentElement;
  let stored = null;
  try { stored = localStorage.getItem("locale"); } catch {}
  const choice = (${langChoice.toString()})(stored, navigator.languages || [navigator.language], ${JSON.stringify(locale)});
  if (choice && "redirect" in choice) {
    location.replace(${JSON.stringify(otherLocalePath)} + location.search + location.hash);
  } else if (choice) {
    root.dataset.langSuggest = "";
  }
})();`;
const pagefindUrl = (import.meta.env.PUBLIC_PAGEFIND_URL ?? "/pagefind").replace(/\/$/, "");
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <Seo
      locale={locale}
      title={title}
      description={description}
      keywords={keywords}
      path={path}
      image={image}
      type={type}
      noindex={noindex}
    />
    <meta name="theme-color" content="#f5f8fb" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0e1621" media="(prefers-color-scheme: dark)">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icons/icon-180.png">
    <link rel="manifest" href="/manifest.webmanifest">
    {/* Runs before first paint so the stored theme never flashes. */}
    <script is:inline define:vars={{ dismissKey }}>
    (() => {
      const root = document.documentElement;
      root.classList.add("js");
      try {
        const stored = localStorage.getItem("theme");
        const dark = stored
          ? stored === "dark"
          : matchMedia("(prefers-color-scheme: dark)").matches;
        root.classList.toggle("dark", dark);
        if (dismissKey && localStorage.getItem(dismissKey)) root.dataset.announcementDismissed = "";
      } catch {}
      if (dismissKey) root.dataset.announcementKey = dismissKey;
    })();
    </script>
    {langScript && <script is:inline set:html={langScript} />}
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only z-50 rounded-md bg-primary px-3 py-2 text-primary-foreground focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      {ui(locale).nav.skipToContent}
    </a>
    {otherLocalePath && <LangSuggest locale={locale} href={otherLocalePath} />}
    <SiteHeader locale={locale} path={path} />
    {paidBars.map((bar, index) => (
        <Announcement locale={locale} announcement={bar} sponsored rotation={index > 0 ? "hidden" : "shown"} />
      ))}
    {!sponsored && announcement && <Announcement locale={locale} announcement={announcement} />}
    {paidBars.length > 1 && <script is:inline set:html={rotatePaidBars} />}
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} path={path} />
    <MobileTabBar locale={locale} path={path} />
    <BackToTop locale={locale} />
    <SearchDialog
      client:search
      locale={locale}
      pagefindUrl={pagefindUrl}
      siteUrl={siteUrl}
      hotKeywords={hotKeywords}
      kindLabels={strings.entry.kind}
      strings={strings.search}
    />
    <script is:inline>
    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const root = document.documentElement;
      if (target.closest("[data-theme-toggle]")) {
        const dark = root.classList.toggle("dark");
        localStorage.setItem("theme", dark ? "dark" : "light");
      } else if (target.closest("[data-lang-switch], [data-lang-stay]")) {
        const choice = target.closest("[data-lang-switch], [data-lang-stay]");
        try {
          localStorage.setItem("locale", choice.dataset.langSwitch || choice.dataset.langStay);
        } catch {}
        delete root.dataset.langSuggest;
      } else if (target.closest("[data-announcement-dismiss]")) {
        root.dataset.announcementDismissed = "";
        if (root.dataset.announcementKey) localStorage.setItem(root.dataset.announcementKey, "1");
      }
    });
    </script>
    <script>
    import "@/scripts/motion.ts";
    </script>
  </body>
</html>
