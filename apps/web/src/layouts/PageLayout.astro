---
import type { SiteLocale } from "@tgbox/shared";
import { t } from "@tgbox/shared";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { localizePath } from "@/i18n/locale.ts";
import { ui } from "@/i18n/ui.ts";
import { formatDate } from "@/lib/format.ts";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  locale: SiteLocale;
  title: string;
  description: string;
  keywords?: string | undefined;
  /** Title for `<title>`/OG when the on-page H1 is shorter than the search-facing one. */
  metaTitle?: string | undefined;
  /** Meta description when the visible lead paragraph isn't the right length for search. */
  metaDescription?: string | undefined;
  /** Short label above the title, e.g. "Guide". */
  eyebrow?: string | undefined;
  /** ISO date the copy was last reviewed. */
  updated?: string | undefined;
  /** Off for pages built from cards rather than running text: no prose styles, full width. */
  prose?: boolean | undefined;
}

const {
  locale,
  title,
  description,
  keywords,
  metaTitle,
  metaDescription,
  eyebrow,
  updated,
  prose = true,
} = Astro.props;
---

<BaseLayout
  locale={locale}
  title={metaTitle ?? title}
  description={metaDescription ?? description}
  keywords={keywords}
  type="article"
>
  <slot name="head" slot="head" />
  <div class="relative isolate overflow-hidden border-b border-border">
    <div class="paper-grid absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 pt-8 pb-12 sm:pt-10 sm:pb-16">
      <Breadcrumbs
        locale={locale}
        items={[{ label: t(locale, "site.home"), href: localizePath("/", locale) }, { label: title }]}
      />
      {eyebrow && (
          <p class="mt-10 font-mono text-xs tracking-[0.2em] text-brand uppercase">{eyebrow}</p>
        )}
      <h1
        class="mt-3 max-w-3xl text-3xl leading-tight font-bold tracking-tight text-balance sm:text-[2.6rem]"
      >
        {title}
      </h1>
      <p
        class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-muted-foreground sm:text-lg"
      >
        {description}
      </p>
      {updated && (
          <p class="mt-6 font-mono text-xs text-muted-foreground">
            {ui(locale).page.updated} · <time datetime={updated}>{formatDate(updated, locale)}</time>
          </p>
        )}
    </div>
  </div>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 py-12 sm:py-16">
    {prose ? <article data-reveal class="prose-tg"><slot /></article> : <slot />}
  </div>
</BaseLayout>
