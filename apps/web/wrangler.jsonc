{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tgbox-web",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "tgbox.cc", "custom_domain": true }],
  "assets": {
    // Astro writes static pages to dist/client; its build also emits dist/server/wrangler.json, which
    // `wrangler deploy` picks up via .wrangler/deploy/config.json.
    "directory": "./dist/client",
    // Public pages never hit the Worker; only dynamic API routes do.
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  }
}
